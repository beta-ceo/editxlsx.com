# Public client config for the Excel SaaS MVP (Appwrite Auth + Storage).
# These are not secrets -- they identify the Appwrite project the browser talks to.
# Copy to `.env` / `.env.local` for local overrides; the defaults in code already
# point at the editxlsx Cloud project.

VITE_APPWRITE_ENDPOINT=https://sfo.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=6aa93e64000c2801517e

# Optional: Cloudflare Web Analytics (landing + editor). Unset = no beacon.
# VITE_CF_BEACON_TOKEN=
